# =============================================================================
# BUBBLES DISCORD BOT - ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3001
FRONTEND_PORT=8080

# Base URLs
API_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:3001/api/v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Connection String (local default for npm run all)
DB_URL=mongodb://localhost:27017/bubbles

# Atlas example:
# DB_URL=mongodb+srv://username:password@cluster.mongodb.net/bubbles

# =============================================================================
# REDIS CONFIGURATION (for rate limiting and caching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# =============================================================================
# DISCORD APPLICATION CONFIGURATION
# =============================================================================
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_TOKEN=your_discord_bot_token_here

# OAuth Redirect URI — must match Discord Developer Portal exactly.
# Website login uses this (Discord returns to the Vue app, which POSTs the code to the API):
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
# Also add this URI in the portal if you ever point Discord at the API instead:
# http://localhost:3001/api/v1/auth/discord/callback

# Frontend build env var – make sure this matches DISCORD_CLIENT_ID above
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure random string for JWT signing
# Used by BOTH the API and the bot. Must be the same value.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# Session secret for Express sessions
SESSION_SECRET=change_me_to_a_long_random_session_secret

# Bot owner / developers (Discord user snowflakes, comma-separated for developers)
OWNER_ID=
DEVELOPER_USER_IDS=

# Bot -> API websocket (defaults are fine for npm run all)
WS_URL=ws://localhost:3001/ws

# Optional: ffmpeg is bundled via ffmpeg-static for voice playback.
# YOUTUBE_COOKIE=

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Frontend URL for CORS (should match FRONTEND_BASE_URL)
CORS_ORIGIN=http://localhost:8080

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# Enable verbose WebSocket logging (set to true for debugging)
WS_LOG_ALL=false

# =============================================================================
# WEBHOOK CONFIGURATION (Optional - for GitHub/Discord integrations)
# =============================================================================
# Discord webhook secret (for bot events)
DISCORD_WEBHOOK_SECRET=your_discord_webhook_secret

# =============================================================================
# SHARED ENV SCHEMA (shared/src/config/env.ts)
# =============================================================================
# Discord server ID used for slash-command registration in development
TEST_GUILD_ID=
WS_URL=ws://localhost:3001/ws
WS_ORIGIN=
METRICS_PORT=9321
METRICS_ENABLED=true
# Required in production for GET /metrics
METRICS_TOKEN=

# =============================================================================
# LOCAL INFRA
# =============================================================================
# docker compose up -d
# Then use:
# DB_URL=mongodb://localhost:27017/bubbles
# REDIS_URL=redis://localhost:6379
